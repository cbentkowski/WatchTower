{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "logging": {
    "logs": {
      "default": {
        "level": "INFO"
      }
    }
  },
  "apps": {
    "http": {
      "http_port": 8888,
      "https_port": 8443,
      "servers": {
        "watchtower": {
          "listen": [
            ":8443"
          ],
          "protocols": [
            "h1",
            "h2"
          ],
          "logs": {},
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "home.thebentkowskis.org"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:4173"
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
